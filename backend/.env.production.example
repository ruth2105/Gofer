# ========================================
# GOFER EXAM - Production Environment Configuration
# ========================================
# Copy this file to .env.production and fill in actual values
# CRITICAL: Never commit the actual .env.production file to version control
# Store production secrets in a secure secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)

# ========================================
# CORE DJANGO SETTINGS (REQUIRED)
# ========================================

# SECRET_KEY: Django secret key (REQUIRED, minimum 32 characters with high entropy)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# CRITICAL: Must be unique and kept secret
SECRET_KEY=

# ALLOWED_HOSTS: Comma-separated list of allowed hostnames (REQUIRED)
# Example: goferexam.com,api.goferexam.com,www.goferexam.com
ALLOWED_HOSTS=

# ========================================
# DATABASE CONFIGURATION (REQUIRED)
# ========================================

# DATABASE_URL: PostgreSQL connection string (REQUIRED)
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Example: postgres://gofer_user:secure_password@prod-db.example.com:5432/gofer_production
# RECOMMENDED: Use SSL/TLS connection (sslmode=require is enforced in production.py)
DATABASE_URL=

# ========================================
# FRONTEND CONFIGURATION (REQUIRED)
# ========================================

# GOFER_FRONTEND_URL: Full HTTPS URL of the Next.js frontend (REQUIRED, no trailing slash)
# MUST be HTTPS in production
# Example: https://goferexam.com or https://app.goferexam.com
GOFER_FRONTEND_URL=

# ========================================
# CORS & CSRF SECURITY (REQUIRED)
# ========================================

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed frontend origins (REQUIRED)
# Must match GOFER_FRONTEND_URL and any additional origins
# Example: https://goferexam.com,https://www.goferexam.com
CORS_ALLOWED_ORIGINS=

# CSRF_TRUSTED_ORIGINS: Comma-separated list of trusted origins for CSRF (REQUIRED)
# Must match GOFER_FRONTEND_URL
# Example: https://goferexam.com,https://www.goferexam.com
CSRF_TRUSTED_ORIGINS=

# AUTH_COOKIE_SECURE: MUST be True in production (enforces HTTPS for auth cookies)
AUTH_COOKIE_SECURE=True

# ========================================
# EMAIL CONFIGURATION (REQUIRED)
# ========================================

# EMAIL_BACKEND: REQUIRED - Choose one of:
#   - django.core.mail.backends.smtp.EmailBackend (standard SMTP)
#   - config.email_backends.brevo.BrevoEmailBackend (Brevo/SendinBlue transactional email)
# CRITICAL: Console, dummy, locmem, and filebased backends are blocked in production
EMAIL_BACKEND=

# GOFER_EMAIL_FROM: Verified sender email address (REQUIRED)
# CRITICAL: Must be verified with your email provider
# Example: noreply@goferexam.com or support@goferexam.com
GOFER_EMAIL_FROM=

# --- SMTP Configuration (if using EMAIL_BACKEND=smtp) ---
# All fields REQUIRED if using SMTP backend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10

# --- Brevo Configuration (if using EMAIL_BACKEND=brevo) ---
# REQUIRED if using Brevo backend
# Get API key from: https://app.brevo.com/settings/keys/api
# BREVO_API_KEY=

# ========================================
# FILE STORAGE CONFIGURATION (REQUIRED)
# ========================================

# STORAGE_BACKEND: Choose one of: S3, GCS, AZURE, R2 (REQUIRED)
# WARNING: LOCAL storage is NOT RECOMMENDED for production (ephemeral, files lost on redeploy)
STORAGE_BACKEND=

# --- AWS S3 Configuration (if STORAGE_BACKEND=S3) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=

# --- Cloudflare R2 Configuration (if STORAGE_BACKEND=R2) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# --- Google Cloud Storage (if STORAGE_BACKEND=GCS) ---
# GS_BUCKET_NAME=
# GS_PROJECT_ID=
# GS_CREDENTIALS=/path/to/service-account.json

# --- Azure Blob Storage (if STORAGE_BACKEND=AZURE) ---
# AZURE_ACCOUNT_NAME=
# AZURE_ACCOUNT_KEY=
# AZURE_CONTAINER=
# AZURE_CUSTOM_DOMAIN=

# ========================================
# MONITORING & LOGGING (RECOMMENDED)
# ========================================

# MONITORING_ENABLED: Enable/disable Sentry error tracking
# RECOMMENDED: Set to True for production monitoring
MONITORING_ENABLED=True

# SENTRY_DSN: Sentry project DSN for error tracking (RECOMMENDED)
# Get from: https://sentry.io/settings/projects/your-project/keys/
# Leave empty to disable Sentry
SENTRY_DSN=

# SENTRY_ENVIRONMENT: Environment name in Sentry
SENTRY_ENVIRONMENT=production

# SENTRY_TRACES_SAMPLE_RATE: Performance monitoring sample rate (0.0 to 1.0)
# RECOMMENDED: Start with 0.1 (10%) to control costs, adjust based on traffic
SENTRY_TRACES_SAMPLE_RATE=0.1

# DJANGO_LOG_LEVEL: Django logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# RECOMMENDED: INFO or WARNING for production
DJANGO_LOG_LEVEL=INFO

# ========================================
# OPTIONAL CONFIGURATIONS
# ========================================

# Email timeout in seconds
EMAIL_TIMEOUT=10

# Email verification token time-to-live in minutes
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60

# Cooldown between resend verification email requests in seconds
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# ========================================
# PRODUCTION SECURITY CHECKLIST
# ========================================
# Before deploying to production, ensure:
# ☐ SECRET_KEY is unique, at least 32 characters, high entropy
# ☐ DEBUG=False (set automatically in production.py)
# ☐ ALLOWED_HOSTS configured with actual domain(s)
# ☐ DATABASE_URL points to production database with SSL
# ☐ GOFER_FRONTEND_URL is HTTPS
# ☐ CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS match frontend
# ☐ EMAIL_BACKEND is SMTP or Brevo (not console/dummy)
# ☐ GOFER_EMAIL_FROM is verified with email provider
# ☐ STORAGE_BACKEND is S3/GCS/AZURE/R2 (not LOCAL)
# ☐ All required credentials are set
# ☐ SSL/TLS certificates are valid
# ☐ Firewall rules allow only necessary ports
# ☐ Database backups are configured
# ☐ Monitoring/logging is enabled (Sentry recommended)
# ☐ Rate limiting is tested
# ☐ Run: python manage.py check --deploy
