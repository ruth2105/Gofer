# ========================================
# GOFER EXAM - Staging Environment Configuration
# ========================================
# Copy this file to .env.staging and fill in actual values
# Never commit the actual .env.staging file to version control

# ========================================
# CORE DJANGO SETTINGS
# ========================================

# SECRET_KEY: Django secret key (required, minimum 32 characters)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-minimum-32-characters-with-high-entropy

# ALLOWED_HOSTS: Comma-separated list of allowed hostnames
# Example: staging.goferexam.com,staging-api.goferexam.com
ALLOWED_HOSTS=localhost,127.0.0.1,staging.yourdomain.com

# ========================================
# DATABASE CONFIGURATION
# ========================================

# DATABASE_URL: PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Example: postgres://gofer_user:secure_password@db.staging.example.com:5432/gofer_staging
DATABASE_URL=postgres://user:password@localhost:5432/gofer_staging

# ========================================
# FRONTEND CONFIGURATION
# ========================================

# GOFER_FRONTEND_URL: Full URL of the Next.js frontend (no trailing slash)
# Must be HTTPS in staging/production
GOFER_FRONTEND_URL=https://staging.yourdomain.com

# ========================================
# CORS & CSRF SECURITY
# ========================================

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed frontend origins
# Must match GOFER_FRONTEND_URL
CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com

# CSRF_TRUSTED_ORIGINS: Comma-separated list of trusted origins for CSRF
# Must match GOFER_FRONTEND_URL
CSRF_TRUSTED_ORIGINS=https://staging.yourdomain.com

# AUTH_COOKIE_SECURE: Set to True in staging/production (HTTPS required)
AUTH_COOKIE_SECURE=True

# ========================================
# EMAIL CONFIGURATION
# ========================================

# EMAIL_BACKEND: Choose one of:
#   - django.core.mail.backends.smtp.EmailBackend (standard SMTP)
#   - config.email_backends.brevo.BrevoEmailBackend (Brevo/SendinBlue)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# GOFER_EMAIL_FROM: Verified sender email address
# Must be a valid, verified email address in your email provider
GOFER_EMAIL_FROM=noreply@yourdomain.com

# --- SMTP Configuration (if using EMAIL_BACKEND=smtp) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
EMAIL_TIMEOUT=10

# --- Brevo Configuration (if using EMAIL_BACKEND=brevo) ---
# Get API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here

# Email Verification Settings
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# ========================================
# FILE STORAGE CONFIGURATION
# ========================================

# STORAGE_BACKEND: Choose one of: LOCAL, S3, GCS, AZURE, R2
# WARNING: LOCAL storage is ephemeral and files will be lost on redeployment
STORAGE_BACKEND=LOCAL

# --- AWS S3 Configuration (if STORAGE_BACKEND=S3) ---
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=gofer-staging-media
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=

# --- Cloudflare R2 Configuration (if STORAGE_BACKEND=R2) ---
# AWS_ACCESS_KEY_ID=your-r2-access-key-id
# AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
# AWS_STORAGE_BUCKET_NAME=gofer-staging
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# --- Google Cloud Storage (if STORAGE_BACKEND=GCS) ---
# GS_BUCKET_NAME=gofer-staging-media
# GS_PROJECT_ID=your-gcp-project-id
# GS_CREDENTIALS=/path/to/service-account.json

# --- Azure Blob Storage (if STORAGE_BACKEND=AZURE) ---
# AZURE_ACCOUNT_NAME=your-azure-account
# AZURE_ACCOUNT_KEY=your-azure-key
# AZURE_CONTAINER=gofer-staging-media
# AZURE_CUSTOM_DOMAIN=

# ========================================
# MONITORING & LOGGING
# ========================================

# MONITORING_ENABLED: Enable/disable Sentry error tracking
MONITORING_ENABLED=True

# SENTRY_DSN: Sentry project DSN (leave empty to disable)
# Get from: https://sentry.io/settings/projects/your-project/keys/
SENTRY_DSN=

# SENTRY_ENVIRONMENT: Environment name in Sentry
SENTRY_ENVIRONMENT=staging

# SENTRY_TRACES_SAMPLE_RATE: Performance monitoring sample rate (0.0 to 1.0)
# 0.1 = 10% of transactions, 1.0 = 100%
SENTRY_TRACES_SAMPLE_RATE=0.1

# DJANGO_LOG_LEVEL: Django logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=INFO

# ========================================
# OPTIONAL CONFIGURATIONS
# ========================================

# These can be left as defaults or customized as needed

# Email timeout in seconds
# EMAIL_TIMEOUT=10

# Email verification token time-to-live in minutes
# EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60

# Cooldown between resend verification email requests in seconds
# EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
