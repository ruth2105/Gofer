# ============================================================================
# GOFER EXAM - STAGING ENVIRONMENT CONFIGURATION
# ============================================================================
# This file contains all environment variables required for staging deployment.
# Copy this file to .env.staging and fill in actual values.
# Staging environment should mirror production as closely as possible.
# ============================================================================

# ----------------------------------------------------------------------------
# DJANGO CORE SETTINGS
# ----------------------------------------------------------------------------

# Generate a staging-specific secret key (different from production)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-staging-secret-key-here-minimum-50-characters-required

# Django settings module (do not change)
DJANGO_SETTINGS_MODULE=config.settings.production

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------

# PostgreSQL connection string (staging database)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@staging-host:5432/staging_db?sslmode=require

# ----------------------------------------------------------------------------
# SECURITY & NETWORKING
# ----------------------------------------------------------------------------

# Staging backend domain
ALLOWED_HOSTS=gofere-staging.onrender.com

# Staging frontend origin for CORS
CORS_ALLOWED_ORIGINS=https://gofere-staging.vercel.app

# Staging trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=https://gofere-staging.onrender.com,https://gofere-staging.vercel.app

# Staging frontend URL
GOFER_FRONTEND_URL=https://gofere-staging.vercel.app

# ----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# ----------------------------------------------------------------------------

# For staging, you can use:
# 1. Console backend (emails printed to logs): django.core.mail.backends.console.EmailBackend
# 2. Same email provider as production (recommended): config.email_backends.brevo.BrevoEmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Staging sender email
GOFER_EMAIL_FROM=staging@goferexam.com

# Brevo API key (staging account or same as production)
BREVO_API_KEY=

# SMTP settings (if using SMTP in staging)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# ----------------------------------------------------------------------------
# FILE STORAGE CONFIGURATION
# ----------------------------------------------------------------------------

# For staging, you can use:
# 1. LOCAL storage (acceptable for staging, but data is ephemeral)
# 2. Separate staging bucket (recommended)
STORAGE_BACKEND=LOCAL

# Staging R2/S3 bucket (if using cloud storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=gofere-staging
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_REGION_NAME=auto

# ----------------------------------------------------------------------------
# MONITORING & LOGGING
# ----------------------------------------------------------------------------

# Enable monitoring in staging
MONITORING_ENABLED=true

# Staging Sentry DSN (separate project from production recommended)
SENTRY_DSN=

# Sentry environment
SENTRY_ENVIRONMENT=staging

# Higher sample rate for staging (capture more traces)
SENTRY_TRACES_SAMPLE_RATE=0.5

# ----------------------------------------------------------------------------
# STAGING-SPECIFIC SETTINGS
# ----------------------------------------------------------------------------

# Allow more verbose error pages in staging (but still secure)
# DEBUG=False (production settings, do not change)

# Relaxed rate limits for testing
# RATE_LIMIT_AUTH_REGISTER=20/hour
# RATE_LIMIT_AUTH_LOGIN=50/minute

# ============================================================================
# STAGING ENVIRONMENT NOTES
# ============================================================================
#
# Staging should mirror production configuration as closely as possible:
# - Use same Django settings module (production.py)
# - Use PostgreSQL (not SQLite)
# - Use HTTPS for all domains
# - Test with production-like data volume
# - Use separate credentials from production
#
# Acceptable differences from production:
# - Console email backend is OK for staging
# - LOCAL storage is acceptable (but cloud storage preferred)
# - Can use same Brevo account with different sender
# - Can have more relaxed rate limits
# - Can have higher Sentry sampling rate
#
# ============================================================================
