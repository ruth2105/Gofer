# ============================================================================
# GOFER EXAM - PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# This file contains all environment variables required for production deployment.
# Copy this file to .env.production and fill in actual values.
# NEVER commit .env.production to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# DJANGO CORE SETTINGS
# ----------------------------------------------------------------------------

# CRITICAL: Generate a strong secret key (50+ characters, random)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-production-secret-key-here-minimum-50-characters-required

# Django settings module (do not change)
DJANGO_SETTINGS_MODULE=config.settings.production

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------

# PostgreSQL connection string (provided by Render automatically)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ----------------------------------------------------------------------------
# SECURITY & NETWORKING
# ----------------------------------------------------------------------------

# Comma-separated list of allowed hostnames
# Example: gofere-api-ruth2105.onrender.com,api.goferexam.com
ALLOWED_HOSTS=your-backend-domain.onrender.com

# Comma-separated list of frontend origins for CORS (must include https://)
# Example: https://gofere.vercel.app,https://www.goferexam.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# Comma-separated list of trusted origins for CSRF protection (must include https://)
# Example: https://gofere-api-ruth2105.onrender.com,https://gofere.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-backend-domain.onrender.com,https://your-frontend-domain.vercel.app

# Frontend URL for email links and redirects (must be https://)
GOFER_FRONTEND_URL=https://your-frontend-domain.vercel.app

# ----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# ----------------------------------------------------------------------------

# Email backend - CHOOSE ONE:
# 1. Brevo (recommended - 300 free emails/day): config.email_backends.brevo.BrevoEmailBackend
# 2. SMTP: django.core.mail.backends.smtp.EmailBackend
# DO NOT USE: django.core.mail.backends.console.EmailBackend (development only)
EMAIL_BACKEND=config.email_backends.brevo.BrevoEmailBackend

# Sender email address (must be verified with your email provider)
# Example: noreply@goferexam.com
GOFER_EMAIL_FROM=noreply@your-domain.com

# ----------------------------------------------------------------------------
# BREVO EMAIL CONFIGURATION (if using Brevo)
# ----------------------------------------------------------------------------

# Brevo API key from https://app.brevo.com/settings/keys/api
# Leave empty if using SMTP instead
BREVO_API_KEY=your-brevo-api-key-here

# ----------------------------------------------------------------------------
# SMTP EMAIL CONFIGURATION (if using SMTP)
# ----------------------------------------------------------------------------

# SMTP server hostname (e.g., smtp.gmail.com, smtp.sendgrid.net)
EMAIL_HOST=smtp.your-provider.com

# SMTP server port (typically 587 for TLS, 465 for SSL)
EMAIL_PORT=587

# SMTP username (often your email address)
EMAIL_HOST_USER=your-smtp-username

# SMTP password or API key
EMAIL_HOST_PASSWORD=your-smtp-password

# Use TLS encryption (recommended for port 587)
EMAIL_USE_TLS=True

# Use SSL encryption (for port 465 only, mutually exclusive with TLS)
EMAIL_USE_SSL=False

# ----------------------------------------------------------------------------
# FILE STORAGE CONFIGURATION
# ----------------------------------------------------------------------------

# Storage backend - CHOOSE ONE:
# - LOCAL: Ephemeral storage (NOT RECOMMENDED for production, files lost on restart)
# - R2: Cloudflare R2 (recommended - 10GB free, S3-compatible)
# - S3: Amazon S3 (costs apply)
# - GCS: Google Cloud Storage (costs apply)
# - AZURE: Azure Blob Storage (costs apply)
STORAGE_BACKEND=R2

# ----------------------------------------------------------------------------
# CLOUDFLARE R2 CONFIGURATION (recommended)
# ----------------------------------------------------------------------------

# R2 Access Key ID from Cloudflare dashboard
AWS_ACCESS_KEY_ID=your-r2-access-key-id

# R2 Secret Access Key from Cloudflare dashboard
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key

# R2 bucket name
AWS_STORAGE_BUCKET_NAME=your-r2-bucket-name

# R2 endpoint URL (format: https://<account_id>.r2.cloudflarestorage.com)
AWS_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# R2 public domain (optional, for direct public access)
# Format: https://your-bucket.your-domain.com
AWS_S3_CUSTOM_DOMAIN=

# R2 region (leave as auto for R2)
AWS_S3_REGION_NAME=auto

# ----------------------------------------------------------------------------
# AMAZON S3 CONFIGURATION (alternative to R2)
# ----------------------------------------------------------------------------

# S3 Access Key ID (if using S3 instead of R2)
# AWS_ACCESS_KEY_ID=your-s3-access-key-id

# S3 Secret Access Key (if using S3 instead of R2)
# AWS_SECRET_ACCESS_KEY=your-s3-secret-access-key

# S3 bucket name (if using S3 instead of R2)
# AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name

# S3 region (if using S3 instead of R2)
# AWS_S3_REGION_NAME=us-east-1

# S3 custom domain (optional, for CloudFront CDN)
# AWS_S3_CUSTOM_DOMAIN=your-cloudfront-domain.cloudfront.net

# Leave empty for S3 (only needed for R2)
# AWS_S3_ENDPOINT_URL=

# ----------------------------------------------------------------------------
# GOOGLE CLOUD STORAGE CONFIGURATION (alternative)
# ----------------------------------------------------------------------------

# GCS bucket name (if using GCS instead of R2/S3)
# GS_BUCKET_NAME=your-gcs-bucket-name

# GCS project ID (if using GCS)
# GS_PROJECT_ID=your-gcs-project-id

# GCS service account credentials path (if using GCS)
# GS_CREDENTIALS=/path/to/service-account.json

# ----------------------------------------------------------------------------
# AZURE BLOB STORAGE CONFIGURATION (alternative)
# ----------------------------------------------------------------------------

# Azure storage account name (if using Azure instead of R2/S3)
# AZURE_ACCOUNT_NAME=your-azure-account-name

# Azure storage account key (if using Azure)
# AZURE_ACCOUNT_KEY=your-azure-account-key

# Azure container name (if using Azure)
# AZURE_CONTAINER=your-azure-container-name

# Azure custom domain (optional, for Azure CDN)
# AZURE_CUSTOM_DOMAIN=your-cdn-domain.azureedge.net

# ----------------------------------------------------------------------------
# MONITORING & LOGGING
# ----------------------------------------------------------------------------

# Enable monitoring and error tracking
MONITORING_ENABLED=true

# Sentry DSN for error tracking (get from https://sentry.io)
# Leave empty to disable Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry environment name
SENTRY_ENVIRONMENT=production

# Sentry sample rate (0.0 to 1.0, recommended: 0.1 for 10% sampling)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ----------------------------------------------------------------------------
# OPTIONAL SETTINGS
# ----------------------------------------------------------------------------

# Rate limiting (leave as default unless you have specific needs)
# Format: requests/period (e.g., 5/hour, 100/day)
# RATE_LIMIT_AUTH_REGISTER=5/hour
# RATE_LIMIT_AUTH_LOGIN=10/minute
# RATE_LIMIT_AUTH_VERIFY=20/hour
# RATE_LIMIT_AUTH_RESEND=5/hour
# RATE_LIMIT_AUTH_PASSWORD_RESET=10/hour

# Email verification cooldown (seconds between resend requests)
# EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=120

# Database connection max age (seconds, default: 600)
# DB_CONN_MAX_AGE=600

# Static files CDN (optional, leave empty to serve from backend)
# STATIC_URL=https://your-cdn-domain.com/static/

# Media files CDN (optional, leave empty to serve from storage backend)
# MEDIA_URL=https://your-cdn-domain.com/media/

# ----------------------------------------------------------------------------
# DEPLOYMENT METADATA (optional, for tracking)
# ----------------------------------------------------------------------------

# Git commit SHA (automatically set by CI/CD)
# GIT_COMMIT_SHA=

# Deployment timestamp (automatically set by CI/CD)
# DEPLOYMENT_TIMESTAMP=

# Build number (automatically set by CI/CD)
# BUILD_NUMBER=

# ============================================================================
# SECURITY CHECKLIST BEFORE DEPLOYING
# ============================================================================
#
# [ ] SECRET_KEY is strong, random, and at least 50 characters
# [ ] DATABASE_URL points to production PostgreSQL with SSL
# [ ] ALLOWED_HOSTS includes only your actual backend domain(s)
# [ ] CORS_ALLOWED_ORIGINS includes only your actual frontend domain(s)
# [ ] CSRF_TRUSTED_ORIGINS includes backend and frontend domains
# [ ] GOFER_FRONTEND_URL is your actual frontend HTTPS URL
# [ ] EMAIL_BACKEND is NOT console backend
# [ ] GOFER_EMAIL_FROM is verified with your email provider
# [ ] Email provider credentials (BREVO_API_KEY or SMTP) are correct
# [ ] STORAGE_BACKEND is NOT LOCAL
# [ ] Storage credentials (R2/S3/GCS/Azure) are correct
# [ ] MONITORING_ENABLED is true
# [ ] SENTRY_DSN is configured (optional but recommended)
# [ ] All domains use HTTPS (no http://)
# [ ] .env.production is in .gitignore
# [ ] .env.production is NEVER committed to git
#
# ============================================================================
